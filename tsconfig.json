{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "outDir": "dist",
    "ignoreDeprecations": "6.0"
  },
  "include": ["playwright.config.ts", "src/**/*.ts"]
}
